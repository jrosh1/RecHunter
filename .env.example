# =============================================================================
# RecHunter – Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Gmail SMTP Credentials ──────────────────────────────────────────────────
# 1. Enable 2-Step Verification on your Google Account
# 2. Go to: Google Account → Security → 2-Step Verification → App Passwords
# 3. Generate a new app password for "Mail" on "Other (RecHunter)"
# 4. Paste the 16-character password below (spaces optional)
GMAIL_ADDRESS=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Phone Number ────────────────────────────────────────────────────────────
# Digits only – no dashes, spaces, or country code prefix
PHONE_NUMBER=5551234567

# ── Carrier SMS Gateway ─────────────────────────────────────────────────────
# This is the email domain used to relay email → SMS.
#
# Common gateways:
#   T-Mobile / Mint Mobile : tmomail.net
#   AT&T                   : txt.att.net
#   Verizon                : vtext.com
#   Sprint                 : messaging.sprintpcs.com
#   Google Fi              : msg.fi.google.com
#   US Cellular            : email.uscc.net
#   Cricket                : sms.cricketwireless.net
CARRIER_GATEWAY=tmomail.net

# ── RIDB API Key (optional) ─────────────────────────────────────────────────
# Free API key from https://ridb.recreation.gov
# Required only for the facility search feature in the dashboard.
RIDB_API_KEY=

# ── Server Settings ─────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8080
